# Copy to .env.local and fill in. Do not commit real secrets.

# Backend API (interview-prep-core)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Socket.IO server (usually the same host as the API)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Google OAuth Client ID (Google Cloud Console > Credentials).
# Leave empty to run without Google sign-in. The origin you open the app on
# (e.g. http://localhost:3000) must be listed under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
