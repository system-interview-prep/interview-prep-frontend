    "clean:empty": "node -e \"const fs=require('fs');const clean=(p)=>{if(!fs.existsSync(p))return;fs.readdirSync(p).forEach(f=>{const fp=require('path').join(p,f);if(fs.statSync(fp).isDirectory()){clean(fp);if(fs.readdirSync(fp).length===0)fs.rmdirSync(fp);}});};clean('./src');\"",
